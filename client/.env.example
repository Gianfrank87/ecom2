# Valor opcional: sin override se usa /api tanto en produccion como en desarrollo.
# Towebs: https://nigdiz.com.ar/api, bajo el mismo dominio y certificado SSL.
# Vite proxifica /api a http://127.0.0.1:5000 sin quitar ni agregar el prefijo.
VITE_API_URL=/api

# Override para conectarse directamente a un backend local (requiere CORS):
# VITE_API_URL=http://localhost:5000/api
# Vite incorpora este valor al compilar: revisar .env*, entorno y CI antes del build.
# VITE_BACKEND_URL no se usa en este proyecto.
