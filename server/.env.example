DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=5000
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Produccion en Render. Para desarrollo, usar http://localhost:5173.
# CLIENT_URL es una sola URL: retorno de Mercado Pago sin Origin.
# FRONTEND_URL es el enlace a la tienda en los emails.
CLIENT_URL=https://nigdiz.com.ar
FRONTEND_URL=https://nigdiz.com.ar
# Lista de origenes adicionales separados por comas (sin paths).
# Los tres dominios de la tienda ya estan permitidos en el codigo.
CORS_ORIGINS=https://nigdiz.com.ar,https://www.nigdiz.com.ar,https://ecomlau-mauve.vercel.app
# Mantener este endpoint del backend, no reemplazarlo por el frontend.
MP_NOTIFICATION_URL=https://ecommercelaura.onrender.com/api/webhooks/mercadopago

# Supabase Storage privado para comprobantes de transferencia.
# La clave secreta es exclusiva del backend: nunca usarla como VITE_* ni enviarla al navegador.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_server_side_secret_key
SUPABASE_RECEIPTS_BUCKET=comprobantes
