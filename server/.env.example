DB_HOST=localhost
DB_PORT=3306
DB_NAME=seholaco_ecommerce
DB_USER=replace_with_towebs_database_user
DB_PASSWORD=replace_with_database_password
DB_CONNECTION_LIMIT=5
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# El panel Node de Towebs debe definir estas variables o usar un .env privado.
# Alternativa a DB_*: DATABASE_URL=mysql://user:encoded_password@localhost:3306/seholaco_ecommerce
CLIENT_URL=https://nigdiz.com.ar
FRONTEND_URL=https://nigdiz.com.ar
CORS_ORIGINS=https://nigdiz.com.ar,https://www.nigdiz.com.ar

# API montada en /api del dominio principal; cambiar tambien el dashboard de MP.
MP_NOTIFICATION_URL=https://nigdiz.com.ar/api/webhooks/mercadopago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Archivos privados en server/uploads/comprobantes; NO exponer como carpeta estatica.
# Debe ser persistente y formar parte del backup del hosting.
RECEIPTS_STORAGE=local

# Email: sin SMTP_PASS se simula el envio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
