DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=5000
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Supabase Storage privado para comprobantes de transferencia.
# La clave secreta es exclusiva del backend: nunca usarla como VITE_* ni enviarla al navegador.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_server_side_secret_key
SUPABASE_RECEIPTS_BUCKET=comprobantes
